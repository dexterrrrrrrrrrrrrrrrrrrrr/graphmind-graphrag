NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Set a strong local password before starting Compose.
NEO4J_PASSWORD=
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
EXTRACTION_MODEL=qwen3:4b
# Native backend default. Compose overrides this to host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=0
REQUEST_TIMEOUT=180
MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=.data
TOP_K=8
MAX_DEPTH=3
SIMILARITY_THRESHOLD=0.15
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
CONTEXT_TOKENS=6000
